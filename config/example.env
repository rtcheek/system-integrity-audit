# Example environment settings for system-integrity-audit 2.0 development.
# Values are documentation, not automatically loaded by the script.
# To apply, source the file before running the audit or set variables in the
# calling environment (including sudo's environment if applicable).

# Placeholder: disables outgoing email, including early-failure messages.
REPORT_TO="username@email.address"

# Replace with a real mailbox to enable multipart HTML/plain email.
# REPORT_TO="admin@example.org"

REPORT_FROM_NAME="System Integrity Audit"
REPORT_FROM_ADDRESS="system-integrity-audit"
SUBJECT_PREFIX="[system integrity audit]"

# Enabled by default since v2.0.0-dev.8. If required tools are missing,
# the audit may install packages via APT/DNF when running with privileges.
# It may also enable persistent journald and restart the journal service
# when persistence is not already configured.
AUTO_INSTALL_REQUIREMENTS=1
AUTO_ENABLE_PERSISTENT_JOURNAL=1
# To opt out independently, override either switch with 0 when launching.
# sudo env AUTO_INSTALL_REQUIREMENTS=0 AUTO_ENABLE_PERSISTENT_JOURNAL=0 \
#   REPORT_TO=username@email.address ./system-integrity-audit

# Development-preview SMART short-test scheduler (enabled by default).
# Set 0 to disable automatic firmware self-tests for a run.
SMART_SHORT_TEST_AUTO=1
# Days between script-initiated tests; native ATA history uses power-on hours.
SMART_SHORT_TEST_AGE_DAYS=60
# Root-only persistent state, created at first permitted test start.
SMART_SHORT_TEST_STATE_FILE="/var/lib/system-integrity-audit/smart-short-tests.tsv"
# Only directly addressed ATA devices may be started automatically.
# A 1-second /proc/stat sample must show CPU idle >98% and iowait <2%.
# SMART_CPU_STAT_PATH="/proc/stat"


# Separate exception policies, both optional.
# File for expected MODIFIED paths, with optional shell globs.
EXCEPTIONS_FILE="/usr/local/etc/system-integrity-audit.ignore"
# File for explicitly approved MISSING files, exact absolute paths only.
# Add no entries by default. An absent file means no approvals.
MISSING_EXCEPTIONS_FILE="/usr/local/etc/system-integrity-audit.missing.ignore"

# RPM/Rocky/RHEL package verification (ignored by the Debian backend).
# Include timestamp-only differences as NOTICE (usually noisy).
RPM_REPORT_TIMESTAMP_ONLY=0
# Maximum total seconds for one full RPM verification scan.
RPM_VERIFY_TIMEOUT_SECONDS=7200
# DNF installation is permitted by default if prerequisites are missing.
# Set AUTO_INSTALL_REQUIREMENTS=0 to prevent automatic installation.
DNF_COMMAND_TIMEOUT_SECONDS=7200

# Show a report even if all checks pass; sending still requires a real REPORT_TO.
FORCE_REPORT=0
