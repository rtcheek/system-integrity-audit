# Example environment settings for system-integrity-audit 2.0 development.
# Values are documentation, not automatically loaded by the script.
# To apply, source the file before running the audit or set variables in the
# calling environment (including sudo's environment if applicable).

# Placeholder: disables outgoing email, including early-failure messages.
REPORT_TO="username@email.address"

# Replace with a real mailbox to enable multipart HTML/plain email.
# REPORT_TO="admin@example.org"

REPORT_FROM_NAME="System Integrity Audit"
REPORT_FROM_ADDRESS="system-integrity-audit"
SUBJECT_PREFIX="[system integrity audit]"

# Avoid changing installed packages or journald settings automatically.
AUTO_INSTALL_REQUIREMENTS=0
AUTO_ENABLE_PERSISTENT_JOURNAL=0

# Set FORCE_REPORT=1 to show/send a report even if healthy.
FORCE_REPORT=0
