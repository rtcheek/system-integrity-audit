is_enabled() {
    case "${1:-}" in
        1|yes|true|on|enabled) return 0 ;;
        *) return 1 ;;
    esac
}

is_nonnegative_integer() {
    [[ ${1:-} =~ ^[0-9]+$ ]]
}

is_percentage_integer() {
    [[ ${1:-} =~ ^(0|[1-9][0-9]?|100)$ ]]
}

trim_whitespace() {
    local value=${1-}
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

# SMART's human-facing diagnostics use literal tabs for alignment. Keep
# these tabs (but not escape/control sequences) in terminal and HTML reports.
sanitize_smart_detail_line() {
    local value=${1-}
    value=${value//\\/\\\\}
    value=${value//$'\033'/\\x1b}
    value=${value//$'\r'/\\r}
    value=${value//$'\n'/\\n}
    value=${value//$'\a'/\\x07}
    value=${value//$'\b'/\\x08}
    printf '%s' "$value"
}


sanitize_text() {
    local value=${1-}
    value=${value//\\/\\\\}
    value=${value//$'\033'/\\x1b}
    value=${value//$'\r'/\\r}
    value=${value//$'\n'/\\n}
    value=${value//$'\t'/\\t}
    value=${value//$'\a'/\\x07}
    value=${value//$'\b'/\\x08}
    printf '%s' "$value"
}


load_exception_patterns() {
    local pattern line_number=0

    exception_patterns=()
    exception_pattern_count=0

    if [[ ! -e $EXCEPTIONS_FILE ]]; then
        return 0
    fi

    if [[ ! -f $EXCEPTIONS_FILE || ! -r $EXCEPTIONS_FILE ]]; then
        printf '%s: exceptions file is not a readable regular file: %s\n' \
            "$PROGRAM_NAME" "$EXCEPTIONS_FILE" >&2
        return 66
    fi

    while IFS= read -r pattern || [[ -n $pattern ]]; do
        line_number=$((line_number + 1))
        pattern=${pattern%$'\r'}

        [[ -z $pattern || $pattern == \#* ]] && continue

        if [[ $pattern != /* ]]; then
            printf '%s: invalid exception on line %s of %s; patterns must be absolute paths: %s\n' \
                "$PROGRAM_NAME" "$line_number" "$EXCEPTIONS_FILE" \
                "$(sanitize_text "$pattern")" >&2
            return 65
        fi

        exception_patterns+=("$pattern")
    done < "$EXCEPTIONS_FILE"

    exception_pattern_count=${#exception_patterns[@]}
    return 0
}

# Missing package files use a separate, explicit allowlist. Unlike the
# modifications file, paths are LITERAL, never shell patterns or globs.
load_missing_exception_paths() {
    local item line_number=0
    missing_exception_paths=()
    missing_exception_count=0

    if [[ ! -e $MISSING_EXCEPTIONS_FILE && ! -L $MISSING_EXCEPTIONS_FILE ]]; then
        return 0
    fi
    if [[ -L $MISSING_EXCEPTIONS_FILE || ! -f $MISSING_EXCEPTIONS_FILE ||
          ! -r $MISSING_EXCEPTIONS_FILE ]]; then
        printf '%s: approved missing-file list is not a readable regular, non-symlink file: %s\n' \
            "$PROGRAM_NAME" "$MISSING_EXCEPTIONS_FILE" >&2
        return 66
    fi
    while IFS= read -r item || [[ -n $item ]]; do
        line_number=$((line_number + 1))
        item=${item%$'\r'}
        [[ -z $item || $item == \#* ]] && continue
        if [[ $item != /* || $item == *'*'* || $item == *'?'* || $item == *'['* || $item == *']'* ]]; then
            printf '%s: invalid exact missing-file path on line %s of %s: %s\n' \
                "$PROGRAM_NAME" "$line_number" "$MISSING_EXCEPTIONS_FILE" \
                "$(sanitize_text "$item")" >&2
            return 65
        fi
        missing_exception_paths+=("$item")
    done < "$MISSING_EXCEPTIONS_FILE"
    missing_exception_count=${#missing_exception_paths[@]}
    return 0
}

missing_path_is_approved() {
    local file_path=$1 item
    for item in "${missing_exception_paths[@]}"; do
        [[ $file_path == "$item" ]] && return 0
    done
    return 1
}

changed_path_is_excepted() {
    local file_path=$1 pattern

    for pattern in "${exception_patterns[@]}"; do
        # The unquoted right-hand side is intentionally treated as a shell glob.
        if [[ $file_path == $pattern ]]; then
            return 0
        fi
    done

    return 1
}

html_escape() {
    printf '%s' "${1-}" | sed \
        -e 's/&/\&amp;/g' \
        -e 's/</\&lt;/g' \
        -e 's/>/\&gt;/g' \
        -e 's/"/\&quot;/g' \
        -e "s/'/\&#39;/g"
}

print_missing_commands() {
    local command_name
    printf '%s cannot start because required commands are missing:\n' "$PROGRAM_NAME" >&2
    for command_name in "$@"; do
        printf '  - %s\n' "$command_name" >&2
    done
    printf '\nInstall the packages providing these commands and run %s again.\n' \
        "$PROGRAM_NAME" >&2
}

require_commands() {
    local command_name
    local -a missing=()

    for command_name in "$@"; do
        if ! command -v "$command_name" >/dev/null 2>&1; then
            missing+=("$command_name")
        fi
    done

    if (( ${#missing[@]} > 0 )); then
        print_missing_commands "${missing[@]}"
        return 127
    fi

    return 0
}

# GNU timeout limits command execution, including a grace period before KILL.
# This cannot forcibly wake a process stuck in uninterruptible kernel sleep.
run_probe() {
    local seconds=$1 rc command_name
    shift
    command_name=${1:-unknown}
    timeout --signal=TERM --kill-after=5s "$seconds" "$@"
    rc=$?
    if (( rc == 124 || rc == 137 )); then
        printf '%s: TIMEOUT: %s exceeded %s seconds (exit %s).\n' \
            "$PROGRAM_NAME" "$command_name" "$seconds" "$rc" >&2
    fi
    return "$rc"
}

# A sentinel recipient means no outgoing mail, including early-error mail.
email_reporting_enabled() {
    [[ -n $REPORT_TO && $REPORT_TO != username@email.address ]]
}

# A minimum-viable error email when the audit exits before normal reporting.
# It intentionally does not depend on the work directory or optional checks.
preflight_failure_email() {
    local rc=$1 reason=$2 tmp_base subject host
    command -v sendmail >/dev/null 2>&1 || return 1
    command -v mktemp >/dev/null 2>&1 || return 1
    tmp_base=$(mktemp -d -t system-integrity-audit-failure.XXXXXXXX) || return 1
    host=$(hostname -f 2>/dev/null || hostname 2>/dev/null || printf 'unknown-host')
    subject="$SUBJECT_PREFIX ERROR - $host"
    printf 'system-integrity-audit %s could not complete its audit.
Exit status: %s
Stage: %s
Host: %s
'         "$PROGRAM_VERSION" "$rc" "$(sanitize_text "$reason")" "$(sanitize_text "$host")" > "$tmp_base/body.txt"
    printf '<html><body><pre>%s</pre></body></html>
'         "$(html_escape "$(cat "$tmp_base/body.txt")")" > "$tmp_base/body.html"
    send_report "$subject" "$tmp_base/body.txt" "$tmp_base/body.html"
    rc=$?
    rm -rf -- "$tmp_base"
    return "$rc"
}

# Set before the first prerequisite check; normal send_report marks an attempt.
