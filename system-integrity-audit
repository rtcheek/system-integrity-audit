    printf 'Kernel:                         %s\n' "$(sanitize_text "$(uname -srmo)")"
    printf 'Report time:                    %s\n' "$(date --iso-8601=seconds)"
    printf 'Kernel log lookback:            %s\n' "$(sanitize_text "$KERNEL_LOG_SINCE")"
    printf 'Exceptions file:                %s\n' "$(sanitize_text "$EXCEPTIONS_FILE")"
    printf 'Exception patterns loaded:      %s\n' "$exception_pattern_count"
    printf 'Approved-missing paths loaded:  %s\n' "$missing_exception_count"
    printf 'Package backend:                 %s\n' "$PACKAGE_BACKEND"
    printf 'Package verifier exit code:      %s\n' "$package_verify_status"
    printf '\n'

    printf 'Audit coverage\n'
    printf -- '--------------\n'
    if is_enabled "$KERNEL_LOG_CHECK_ENABLED"; then
        if (( kernel_scan_error > 0 )); then
            printf 'Kernel event review:            INCOMPLETE (journal query failed)\n'
        elif (( kernel_coverage_unknown > 0 )); then
            printf 'Kernel event review:            INCOMPLETE (retention unknown)\n'
        elif (( kernel_coverage_gap > 0 )); then
            printf 'Kernel event review:            PARTIAL (shorter than requested lookback)\n'
        else
            printf 'Kernel event review:            COMPLETED (retained journal)\n'
        fi
    else
        printf 'Kernel event review:            DISABLED\n'
    fi
    if is_enabled "$FILESYSTEM_CHECKS_ENABLED"; then
        if (( filesystem_check_error_count > 0 )); then
            printf 'Filesystem/RAID review:         INCOMPLETE (%s command checks failed)\n' \
                "$filesystem_check_error_count"
        else
            printf 'Filesystem/RAID review:         COMPLETED (where supported)\n'
        fi
    else
        printf 'Filesystem/RAID review:         DISABLED\n'
    fi
    if is_enabled "$SMART_CHECK_ENABLED"; then
        if (( smart_error_count + smart_unsupported_count > 0 )); then
            printf 'SMART physical disk review:     PARTIAL (%s command failures, %s unsupported)\n' \
                "$smart_error_count" "$smart_unsupported_count"
        else
            printf 'SMART physical disk review:     COMPLETED (%s physical devices)\n' "$smart_device_count"
        fi
    else
        printf 'SMART physical disk review:     DISABLED\n'
    fi
    if (( package_run_status > 0 || coverage_status > 0 )) || \
       { [[ $PACKAGE_BACKEND == rpm ]] && (( rpm_unparsed_count + rpm_unverifiable_count > 0 )); }; then
        printf 'Package-file verification:      INCOMPLETE\n'
    else
        printf 'Package-file verification:      COMPLETED (native %s database)\n' \
            "$PACKAGE_BACKEND"
    fi
    printf '\n'

    printf 'Summary\n'
    printf -- '-------\n'
    printf 'Kernel storage log alerts:      %s\n' "$kernel_finding_count"
    printf 'Kernel storage log warnings:    %s\n' "$kernel_warning_count"
    printf 'Kernel log scan errors:         %s\n' "$kernel_scan_error"
    printf 'Kernel journal coverage:        %s\n' "$kernel_coverage_summary"
    printf 'Kernel journal persistence:     %s\n' "$kernel_persistence_summary"
    printf 'Local mounts evaluated:         %s\n' "$filesystem_mount_count"
    printf 'Unique filesystems evaluated:   %s\n' "$filesystem_unique_count"
    printf 'Filesystem alerts:              %s\n' "$filesystem_alert_count"
    printf 'Filesystem warnings:            %s\n' "$filesystem_warning_count"
    printf 'Filesystem notices:             %s\n' "$filesystem_notice_count"
    printf 'Filesystem check errors:        %s\n' "$filesystem_check_error_count"
    printf 'Unexpected read-only mounts:    %s\n' "$readonly_mount_count"
    printf 'Space/inode findings:           %s\n' "$capacity_finding_count"
    printf 'Inode checks not applicable:    %s\n' "$inode_not_applicable_count"
    printf 'Boot fsck services checked:     %s\n' "$fsck_unit_count"
    printf 'Boot fsck findings:             %s\n' "$fsck_finding_count"
    printf 'Linux MD arrays checked:        %s\n' "$md_array_count"
    printf 'Btrfs filesystems checked:      %s\n' "$btrfs_filesystem_count"
    printf 'ZFS pools checked:              %s\n' "$zfs_pool_count"
    printf 'LVM volumes checked:            %s\n' "$lvm_volume_count"
    printf 'Deep-check targets reviewed:    %s\n' "$deep_check_target_count"
    printf 'SMART devices checked:          %s\n' "$smart_device_count"
    printf 'SMART healthy devices:          %s\n' "$smart_ok_count"
    printf 'SMART warnings:                 %s\n' "$smart_warning_count"
    printf 'SMART failures:                 %s\n' "$smart_fail_count"
    printf 'SMART command errors:           %s\n' "$smart_error_count"
    printf 'SMART unsupported devices:      %s\n' "$smart_unsupported_count"
    printf 'SMART short tests initiated:    %s\n' "$smart_short_test_started_count"
    printf 'SMART short tests skipped:      %s\n' "$smart_short_test_skipped_count"
    printf 'Changed package files:          %s\n' "$changed_count"
    printf 'Package config/metadata warnings: %s\n' "$package_warning_count"
    if [[ $PACKAGE_BACKEND == rpm ]]; then
        printf 'RPM runtime directories absent: %s (NOTICE)\n' "$rpm_runtime_dir_notice_count"
        printf 'RPM timestamp-only skipped:     %s\n' "$rpm_timestamp_ignored_count"
        printf 'RPM unparsed records:           %s\n' "$rpm_unparsed_count"
    fi
    printf 'Missing package files:          %s\n' "$missing_count"
    printf 'Approved missing files ignored: %s\n' "$approved_missing_count"
    printf 'Expected changed files ignored: %s\n' "$ignored_changed_count"
    printf 'Packages without checksum data: %s\n' "$coverage_count"
    printf 'Automatic system changes:       %s\n' "$automatic_change_count"
    printf 'Automatic change warnings:      %s\n' "$automatic_warning_count"
    printf 'Automatic change notices:       %s\n' "$automatic_notice_count"
    printf 'Notification findings new:      %s\n' "$notification_new_count"
    printf 'Notification findings ongoing:  %s\n' "$notification_ongoing_count"
    printf 'Notification findings resolved: %s\n' "$notification_resolved_count"
    printf '\n'

    if (( kernel_finding_count > 0 )); then
        printf 'Recent kernel storage alerts\n'
        printf -- '----------------------------\n'
        while IFS= read -r line || [[ -n $line ]]; do
            printf 'KERNEL    %s\n' "$line"
        done < "$kernel_findings_file"
        printf '\n'
    fi

    if (( kernel_warning_count > 0 )); then
        printf 'Recent kernel storage warnings\n'
        printf -- '------------------------------\n'
        while IFS= read -r line || [[ -n $line ]]; do
            printf 'WARNING   %s\n' "$line"
        done < "$kernel_warnings_file"
        printf '\n'
    fi

    if (( kernel_scan_error > 0 )); then
        printf 'Recent kernel storage scan error\n'
        printf -- '--------------------------------\n'
        printf 'ERROR     Unable to read the kernel journal for the requested period.\n'
        while IFS= read -r line || [[ -n $line ]]; do
            printf 'ERROR     %s\n' "$(sanitize_text "$line")"
        done < "$kernel_scan_error_file"
        printf '\n'
    fi

    if [[ -s $filesystem_findings_file ]]; then
        printf 'Filesystem, RAID, and capacity findings\n'
        printf -- '---------------------------------------\n'
        printf '%-9s %-15s %-28s %s\n' 'STATUS' 'CATEGORY' 'RESOURCE' 'DETAIL'
        printf '%-9s %-15s %-28s %s\n' '---------' '---------------' '----------------------------' '------'
        while IFS=$'\t' read -r severity category resource detail; do
            [[ -n ${severity:-} ]] || continue
            printf '%-9s %-15s %-28s %s\n' \
                "$severity" "$category" "$resource" "$detail"
        done < "$filesystem_findings_file"
        printf '\n'
    fi

    if [[ -s $filesystem_details_file ]]; then
        printf 'Filesystem and RAID details\n'
        printf -- '---------------------------\n'
        cat "$filesystem_details_file"
    fi

    if [[ -s $smart_summary_file ]] && \
       { is_enabled "$FORCE_REPORT" || (( smart_warning_count + smart_fail_count + smart_error_count + smart_unsupported_count > 0 )); }; then
        printf 'SMART device summary\n'
        printf -- '--------------------\n'
        printf '%-12s %-20s %-28s %s\n' 'STATUS' 'DEVICE' 'MODEL' 'HEALTH/DETAIL'
        printf '%-12s %-20s %-28s %s\n' '------------' '--------------------' '----------------------------' '-------------'
        while IFS=$'\t' read -r status device model health; do
            printf '%-12s %-20s %-28s %s\n' "$status" "$device" "$model" "$health"
        done < "$smart_summary_file"
        printf '\n'
    fi

    if [[ -s $smart_short_test_notes_file ]]; then
        printf 'SMART short self-test activity\n'
        printf -- '------------------------------\n'
        while IFS=$'\t' read -r action device explanation; do
            printf '%-9s %-20s %s\n' "$action" "$device" "$explanation"
        done < "$smart_short_test_notes_file"
        printf '\n'
    fi

    if [[ -s $smart_details_file ]]; then
        printf 'SMART details\n'
        printf -- '-------------\n'
        cat "$smart_details_file"
    fi

    if [[ -s $findings_file ]]; then
        printf 'Package files that failed verification\n'
        printf -- '--------------------------------------\n'
        printf '%-9s %-40s %s\n' 'STATUS' 'PACKAGE(S)' 'FILE'
        printf '%-9s %-40s %s\n' '---------' '----------------------------------------' '----'
        while IFS=$'\t' read -r status package_name file_path; do
            printf '%-9s %-40s %s\n' "$status" "$package_name" "$file_path"
        done < "$findings_file"
        printf '\n'
    fi

    if [[ -s $ignored_findings_file ]]; then
        printf 'Expected package verification differences ignored\n'
        printf -- '--------------------------------------\n'
        printf '%-9s %-40s %s\n' 'STATUS' 'PACKAGE(S)' 'FILE'
        printf '%-9s %-40s %s\n' '---------' '----------------------------------------' '----'
        while IFS=$'\t' read -r status package_name file_path; do
            printf '%-9s %-40s %s\n' "$status" "$package_name" "$file_path"
        done < "$ignored_findings_file"
        printf '\n'
    fi

    if [[ -s $coverage_safe_file ]]; then
        printf 'Packages not checked because checksum data is absent\n'
        printf -- '----------------------------------------------------\n'
        cat "$coverage_safe_file"
        printf '\n'
        printf 'Run debsums_init as root to create missing checksum manifests where\n'
        printf 'matching package archives are available.\n\n'
    fi

    if [[ -s $diagnostics_safe_file ]]; then
        printf 'Raw package verification diagnostics\n'
        printf -- '------------------------\n'
        cat "$diagnostics_safe_file"
        printf '\n'
    fi

    if [[ -s $automatic_changes_file ]]; then
        printf 'Automatic system changes\n'
        printf -- '------------------------\n'
        while IFS=$'\t' read -r change_severity change_message || \
              [[ -n ${change_severity:-}${change_message:-} ]]; do
            [[ -n ${change_severity:-} ]] || continue
            printf '%-9s %s\n' \
                "$(sanitize_text "$change_severity")" \
                "$(sanitize_text "${change_message:-}")"
        done < "$automatic_changes_file"
        printf '\n'
    fi

    if [[ -s $execution_notes_file ]]; then
        printf 'Audit execution notes\n'
        printf -- '---------------------\n'
        while IFS= read -r line || [[ -n $line ]]; do
            printf 'IMPORTANT: %s\n' "$(sanitize_text "$line")"
        done < "$execution_notes_file"
        printf '\n'
    fi

    if [[ -s $resolved_findings_file ]]; then
        printf 'Resolved since previous audit\n'
        printf -- '-----------------------------\n'
        while IFS=$'\t' read -r severity category resource; do
            [[ -n $severity ]] || continue
            printf 'RESOLVED  %-9s %-18s %s\n' "$severity" "$category" "$resource"
        done < "$resolved_findings_file"
        printf '\n'
    fi

    printf 'Scope and interpretation\n'
    printf -- '------------------------\n'
    printf 'This section is general coverage information; it does not indicate that\n'
    printf 'a storage problem was detected. Any detected storage issue is listed\n'
    printf 'explicitly in the kernel-log, filesystem/RAID, or SMART sections above.\n'
    printf 'The audit checks mount state, capacity, boot fsck results, selected RAID and\n'
    printf 'filesystem-native health data, and recorded scrub status. It does not run\n'
    printf 'fsck, repair filesystems, or start deep scrubs. No online health check can\n'
    printf 'guarantee every disk, cable, controller, RAID, virtual-storage, or\n'
    printf 'filesystem condition. %s checks package-managed\n' "$PACKAGE_VERIFY_TOOL"
    if [[ $PACKAGE_BACKEND == dpkg ]]; then
        printf 'file checksums where manifests are available. Modified paths may be\n'
    else
        printf 'file attributes stored in the RPM database. Config and metadata\n'
        printf 'differences produce warnings; timestamp-only changes are skipped unless\n'
        printf 'RPM_REPORT_TIMESTAMP_ONLY=1 is configured. Modified paths may be\n'
    fi
    printf 'suppressed by exceptions; separately approved missing files remain visible.\n'
    printf '%s does not verify arbitrary local data, and cannot establish that\n' "$PACKAGE_VERIFY_TOOL"
    printf 'the local package database is trustworthy. Embedded-newline filenames\n'
    printf 'remain limited by line-oriented verification output. RPM metadata and\n'
    printf 'config differences are reported separately from changed package payloads.\n'
} > "$report_file"

build_html_report "$subject" "$subject_state"
progress_finish done
print_terminal_report "$report_file" "$subject_state"

# The default placeholder or empty recipient means no outgoing mail.
# Crucially, do not mark notifications as delivered in the state file.
if ! email_reporting_enabled; then
    if ! save_notification_state 0; then
        printf '%s: unable to persist notification state.\n' "$PROGRAM_NAME" >&2
        exit 1
    fi
    if progress_output_enabled; then
        printf 'Email disabled (REPORT_TO is a placeholder or empty); report was not mailed.\n' >&2
    fi
    exit "$final_exit_status"
fi

failure_context='sending email report'
progress_start 'Sending email report' 
if ! send_report "$subject" "$report_file" "$html_report_file"; then
    progress_finish failed
    exit 1
fi
progress_finish done

if ! save_notification_state 1; then
    printf '%s: email sent, but notification state could not be saved.\n' \
        "$PROGRAM_NAME" >&2
    exit 1
fi

logger -p user.notice -t "$PROGRAM_NAME" \
    "Sent $subject_state report for $system_name to $REPORT_TO"

exit "$final_exit_status"
